PRIVACYGUARD_ALLOWED_ROOTS=/Users/your-name/Documents:/Users/your-name/Desktop:/Users/your-name/Downloads
PRIVACYGUARD_DATA_DIR=~/.privacyguard
PRIVACYGUARD_MAX_FILE_BYTES=52428800
PRIVACYGUARD_REFERENCE_TTL=900
PRIVACYGUARD_PRESIDIO_URL=http://127.0.0.1:5002
PRIVACYGUARD_REDACTION_BASE_URL=http://127.0.0.1:8000
PRIVACYGUARD_REDACTION_TOKEN=
# Optional Apple Silicon MLX runtime. Set an absolute path in the MCP process environment.
# PRIVACYGUARD_MLX_PYTHON=/absolute/path/PrivacyGuard/.venv-mlx/bin/python
# PRIVACYGUARD_MODEL_DIR=/absolute/path/PrivacyGuard/models/qwen3/Qwen3-1.7B-bf16
# PrivacyGuard-owned model calls only. Keep local-only for the bundled on-device MLX server.
PRIVACYGUARD_LLM_MODEL=openai//absolute/path/PrivacyGuard/models/qwen3/Qwen3-1.7B-bf16
PRIVACYGUARD_LLM_BASE_URL=http://127.0.0.1:8011/v1
PRIVACYGUARD_LLM_API_KEY=local-only
